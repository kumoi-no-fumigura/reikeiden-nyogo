 "poems": [
  {
   "seq": "1",
   "text": "わがやどに吹くる風のにほへるはかきねの梅のはなやさく",
   "kana": "",
   "speaker": "月廿九日斷簡",
   "page": 212,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "ながつきのながきよてらす月をみてまだくれぬひとおもひけるかな",
   "kana": "",
   "speaker": "いでは",
   "page": 212,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "あかねさすひかりとぞみるなにたかき月はまことにこよひなりけり",
   "kana": "",
   "speaker": "たご",
   "page": 212,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "うぐひすのこゑなかりせば雪きえぬやまざといかで春をしらまし",
   "kana": "",
   "speaker": "あつたゞ中務集ニあり",
   "page": 212,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "ちるはなをゝしみつゝなくうぐひすのなみだやはるの露となるらん",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "あひみてもなをなぐさまぬ心かないくちよねてかこひはさむらん",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "1128193",
   "form": "短歌",
   "genre": ""
  }
